apiVersion: v1
kind: Secret
metadata:
  name: integrations
  namespace: integrations
  labels:
    project: integrations
    service: integrations
stringData:

  APP_ENV: develop

  TZ: 'America/La_Paz'

  DB_HOST: 'integrations-db'
  DB_PORT: '5432'
  DB_NAME: 'integrations'
  DB_USERNAME: 'postgres'
  DB_PASSWORD: 'integrations-password'
  DB_SCHEMA: 'integrations'

  KAFKA_ENABLED: 'true'
  KAFKA_BROKERS: 'kafka-1:9092,kafka-2:9093'
  KAFKA_GROUP_ID: 'integrations'
  KAFKA_CONSUMER_CONNECTION_TIMEOUT: '10000'
  KAFKA_CONSUMER_RETRIES: '3'
  KAFKA_CONSUMER_RETRY_FACTOR: '2'
  KAFKA_CONSUMER_INITIAL_RETRY_TIME: '3000'
  KAFKA_CONSUMER_SESSION_TIMEOUT: '100000'
  KAFKA_CONSUMER_HEARTBEAT_INTERVAL: '10000'

  MULTIPAGO_URL: 'https://wwwstg1.multipago.com'
  MULTIPAGO_PROVIDER: 'app_cainco'
  MULTIPAGO_REFERENCE_STATUS: 'reservado'
  MULTIPAGO_SERVICE_CODE: 'APP_CAINCO_URL'
  MULTIPAGO_URL_CONFIRM: 'https://google.com/confirm'
  MULTIPAGO_URL_FAIL: 'https://google.com/fail'
  MULTIPAGO_UID: '46b2e139e16b52fd43ac8922070e9abb'

  ENABLED_CRON_JOB_EXECUTE_QUEUE_REGISTRIES: 'true'
  CRON_JOB_EXECUTE_QUEUE_REGISTRIES= '* * * * *'
  QUEUE_REGISTRY_MAX_RETRIES: '3'

  ENABLED_CRON_JOB_EXECUTE_PAY_ORDERS: 'true'
  CRON_JOB_EXECUTE_PAY_ORDERS: '* * * * *'